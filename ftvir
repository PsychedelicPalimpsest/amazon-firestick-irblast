#!/usr/bin/env bash
# Fire Stick → remote IR (no HDMI-CEC).
# Control uses custom_components/firetv_ir (same stack as Home Assistant).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

if [[ -f "$ROOT/config.env" ]]; then
  # shellcheck disable=SC1091
  set -a; source "$ROOT/config.env"; set +a
fi

if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PYTHON="$ROOT/.venv/bin/python"
else
  PYTHON="${PYTHON:-python3}"
fi

die() { echo "$*" >&2; exit 1; }

py() {
  exec "$PYTHON" "$ROOT/tools/ftvir_cli.py" "$@"
}

# setup stays bash (Magisk module)
if [[ "${1:-}" == "setup" ]]; then
  exec "$ROOT/setup_permanent.sh"
fi

# Help without python if missing deps
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "" ]]; then
  cat <<EOF
ftvir — Fire Stick IR (Home Assistant firetv_ir engine)

Setup
  ./ftvir setup
  ./ftvir status
  ./ftvir use-profile CODESET_ID   # cache codes (e.g. 4696)

Power
  ./ftvir on | off | toggle

Any button
  ./ftvir send VOLUME_UP
  ./ftvir buttons
  ./ftvir VOLUME_UP                # shorthand

Catalog
  ./ftvir brands --filter Vizio
  ./ftvir profiles BRAND_ID
  ./ftvir remotes | ping | state

Legacy
  ./ftvir blast --json codes/power.json
  ./ftvir power                    # toggle if profile cached, else fixture JSON

Config: config.env (see config.env.example)
EOF
  exit 0
fi

# Compatibility shims → Python CLI
case "${1:-}" in
  blast)
    shift
    mac="${FTVIR_MAC:-}"
    json=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --mac) mac="$2"; shift 2 ;;
        --json) json="$2"; shift 2 ;;
        *) die "unknown blast option: $1" ;;
      esac
    done
    [[ -n "$json" ]] || die "usage: ftvir blast --json FILE [--mac MAC]"
    if [[ -n "$mac" ]]; then
      py --mac "$mac" blast-json "$json"
    else
      py blast-json "$json"
    fi
    ;;
  power)
    if [[ -f "$ROOT/codes/profile_cache.json" ]]; then
      py toggle
    else
      py blast-json "${FTVIR_CODE:-codes/power.json}"
    fi
    ;;
  # Function-name shorthand: ./ftvir VOLUME_UP
  [A-Z]*_[A-Z0-9_]*|[A-Z][A-Z0-9]*)
    if [[ "$1" =~ ^[A-Z][A-Z0-9_]*$ ]] && [[ "$1" != "ANDROID_SERIAL" ]]; then
      fn="$1"
      shift
      py send "$fn" "$@"
    else
      py "$@"
    fi
    ;;
  *)
    py "$@"
    ;;
esac
