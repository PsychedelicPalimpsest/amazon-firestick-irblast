<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mitch.ftvir"
    android:versionCode="7"
    android:versionName="1.6">
    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="22" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.AMAZON_REMOTE_DFU" />
    <uses-permission android:name="com.amazon.dcp.sso.permission.USE_DEVICE_CREDENTIALS" />
    <uses-permission android:name="com.amazon.identity.auth.device.perm.AUTH_SDK" />
    <uses-permission android:name="com.amazon.identity.permission.GENERIC_IPC" />
    <!-- signature|system — Magisk priv-app may receive these -->
    <uses-permission android:name="com.amazon.tv.devicecontrol.READ" />
    <uses-permission android:name="com.amazon.tv.devicecontrol.WRITE" />
    <application android:label="@string/app_name" android:allowBackup="false">
        <uses-library android:name="com.amazon.identity.auth.device" android:required="false" />
        <service
            android:name=".AgentService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.mitch.ftvir.RPC" />
            </intent-filter>
        </service>
        <service
            android:name=".BlastService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.mitch.ftvir.BLAST" />
            </intent-filter>
        </service>
    </application>
</manifest>
