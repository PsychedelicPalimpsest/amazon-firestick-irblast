# Copy to config.env and edit. Sourced by ./ftvir
#
# ADB target (USB or wifi). Example wifi: 192.168.1.112:5555
ANDROID_SERIAL=192.168.1.112:5555

# Paired Fire TV Voice Remote Bluetooth MAC
FTVIR_MAC=14:91:38:B5:D6:69

# Prefer host adb server (same as `adb devices`) for the Python CLI
FTVIR_ADB_SERVER=127.0.0.1
# FTVIR_ADBKEY=                 # only if not using ADB server
# FTVIR_REGION=na

# Power semantics (same as HA integration)
# discrete | toggle_with_state | toggle_only
FTVIR_POWER_MODE=toggle_with_state
# devicecontrol (recommended) | ping | hdmi_link | stick_awake | assumed
# devicecontrol = DeviceControl getScreenState (TV/HPD fused). Not Stick awake.
# stick_awake = androidtv HA preview signal — Fire Stick only, not the TV.
FTVIR_STATE_SOURCE=devicecontrol
# FTVIR_TV_IP=192.168.1.50

# Cached codeset used by on/off/send (written by: ./ftvir use-profile ID)
# FTVIR_PROFILE_CACHE=codes/profile_cache.json

# Legacy InstantFire JSON for `ftvir power` when no profile cache exists
FTVIR_CODE=codes/power.json
